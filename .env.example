# ==============================================================================
# ZMAIL / MailOps — AWS Production Environment Configuration
# ==============================================================================

# 1. Host Infrastructure (Leave PUBLIC_IP blank for automated consensus detection)
PUBLIC_IP=
SMTP_HOSTNAME=mail.yourdomain.com
PRIMARY_DOMAIN=yourdomain.com

# 2. Port Bindings
WEB_PORT=3000
API_PORT=8080
SMTP_PORT=25
SMTP_SUBMISSION_PORT=587
SMTP_ALT_PORT=2525

# 3. Security & Redis
REDIS_URL=redis:6379
NODE_ENV=production
