  "playbooks": [
    {
      "id": "playbook-cold-b2b",
      "name": "High-Deliverability Enterprise Cold Cadence",
      "description": "3-step benchmark sequence with automatic threading, context bumps, and deliverability safeguards.",
      "category": "b2b_sales",
      "target_audience": "Enterprise CTOs, VPs of Eng, Technical Founders",
      "estimated_days": 7,
      "steps": [
        {
          "id": "step-1",
          "step_number": 1,
          "title": "Step 1: 2026 Deliverability Index",
          "subject": "2026 Enterprise Email Authentication \u0026 Deliverability Index for {{company}}",
          "body_html": "\u003cp\u003eHi {{first_name}},\u003c/p\u003e\u003cp\u003eWe recently analyzed post-2024 DMARC and Yahoo/Google inbox placement metrics across 40M enterprise emails. We noticed that several domains in the {{company}} sector experienced soft-deferral cascades on port 25.\u003c/p\u003e\u003cp\u003eWe put together a tailored benchmark showing the exact SPF/DKIM alignment and dedicated IP warmup curves required for 99.4% primary inbox placement.\u003c/p\u003e\u003cp\u003eWould you like me to send over the benchmark executive summary?\u003c/p\u003e\u003cp\u003eBest regards,\u003cbr\u003e{{sender_name}}\u003c/p\u003e",
          "body_preview": "We recently analyzed post-2024 DMARC and Yahoo/Google inbox placement metrics across 40M enterprise emails...",
          "delay_days": 0,
          "delay_hours": 0,
          "send_days": "business_days",
          "trigger_condition": "immediate",
          "is_threaded_reply": false,
          "created_at": "2026-11-19T13:55:25.064351849Z"
        },
        {
          "id": "step-2",
          "step_number": 2,
          "title": "Step 2: Relevant Case Study \u0026 Benchmark Bump",
          "subject": "Re: 2026 Enterprise Email Authentication \u0026 Deliverability Index for {{company}}",
          "body_html": "\u003cp\u003eHi {{first_name}},\u003c/p\u003e\u003cp\u003eQuick follow-up on my note from earlier this week. One of our recent fintech partners reduced spam complaint rates to \u0026lt;0.01% within 14 days by implementing automated mailbox pooling and reverse DNS verification.\u003c/p\u003e\u003cp\u003eHappy to share their anonymized audit blueprint if helpful for {{company}}.\u003c/p\u003e\u003cp\u003eBest,\u003cbr\u003e{{sender_name}}\u003c/p\u003e",
          "body_preview": "Quick follow-up on my note from earlier this week. One of our recent fintech partners reduced spam complaints...",
          "delay_days": 3,
          "delay_hours": 0,
          "send_days": "business_days",
          "trigger_condition": "no_reply",
          "is_threaded_reply": true,
          "created_at": "2026-11-19T13:55:25.064351994Z"
        },
        {
          "id": "step-3",
          "step_number": 3,
          "title": "Step 3: Polite Breakup \u0026 Permission to Close",
          "subject": "Re: 2026 Enterprise Email Authentication \u0026 Deliverability Index for {{company}}",
          "body_html": "\u003cp\u003eHi {{first_name}},\u003c/p\u003e\u003cp\u003eI realize you are likely heads down on critical engineering initiatives. I won't crowd your inbox any further.\u003c/p\u003e\u003cp\u003eIf email infrastructure, IP warmup, or Yahoo/Google deliverability compliance becomes a priority later this quarter, feel free to reconnect.\u003c/p\u003e\u003cp\u003eWishing you and {{company}} continued success,\u003cbr\u003e{{sender_name}}\u003c/p\u003e",
          "body_preview": "I realize you are likely heads down on critical engineering initiatives. I won't crowd your inbox any further...",
          "delay_days": 4,
          "delay_hours": 0,
          "send_days": "business_days",
          "trigger_condition": "no_reply",
          "is_threaded_reply": true,
          "created_at": "2026-11-19T13:55:25.064352066Z"
        }
      ],
      "created_at": "2026-11-19T13:55:25.064352138Z"
    },
    {
      "id": "playbook-saas-onboarding",
      "name": "SaaS Product Onboarding \u0026 Activation Cadence",
      "description": "4-step developer onboarding sequence ensuring new organizations configure SMTP, verify DKIM, and launch safely.",
      "category": "saas_onboarding",
      "target_audience": "New Trial Organizations \u0026 Platform Developers",
      "estimated_days": 14,
      "steps": [
        {
          "id": "ob-1",
          "step_number": 1,
          "title": "Step 1: Cluster Credentials \u0026 Quickstart",
          "subject": "Welcome to ZMAIL — Your Dedicated SMTP Injection Endpoint",
          "body_html": "\u003ch2\u003eWelcome aboard, {{first_name}}!\u003c/h2\u003e\u003cp\u003eYour dedicated organization tenant is provisioned and ready for injection.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eSMTP Host:\u003c/strong\u003e 127.0.0.1:2525 (or ports 25, 587)\u003cbr\u003e\u003cstrong\u003eREST Gateway:\u003c/strong\u003e http://localhost:8080/api/v1\u003c/p\u003e\u003cp\u003eNext step: verify your custom sending domain in the Domains \u0026amp; DNS app.\u003c/p\u003e",
          "body_preview": "Your dedicated organization tenant is provisioned and ready for injection...",
          "delay_days": 0,
          "delay_hours": 0,
          "send_days": "all_days",
          "trigger_condition": "immediate",
          "is_threaded_reply": false,
          "created_at": "2026-11-19T13:55:25.06436093Z"
        },
        {
          "id": "ob-2",
          "step_number": 2,
          "title": "Step 2: DNS \u0026 DKIM Verification Checklist",
          "subject": "Action Required: Complete SPF \u0026 DKIM Alignment for {{company}}",
          "body_html": "\u003cp\u003eHi {{first_name}},\u003c/p\u003e\u003cp\u003eWe noticed your domain verification is still pending. To guarantee your outbound messages bypass the spam box, add your generated 2048-bit DKIM TXT record to your DNS provider.\u003c/p\u003e\u003cp\u003eVisit your dashboard to copy your exact DNS records in one click.\u003c/p\u003e",
          "body_preview": "We noticed your domain verification is still pending. To guarantee your outbound messages bypass spam...",
          "delay_days": 2,
          "delay_hours": 0,
          "send_days": "all_days",
